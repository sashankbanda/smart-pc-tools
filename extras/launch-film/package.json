{
  "name": "smart-pc-tools-launch-film",
  "private": true,
  "type": "module",
  "description": "The Smart PC Tools launch film: real app screens, a neural voice-over, music and sound composed in code.",
  "scripts": {
    "capture": "powershell -NoProfile -STA -ExecutionPolicy Bypass -File scripts/capture.ps1",
    "voice": "node scripts/voice.mjs",
    "audio": "node scripts/audio.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "check": "node scripts/check.mjs",
    "film": "node scripts/voice.mjs && node scripts/audio.mjs && node scripts/render.mjs && node scripts/check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/bundler": "4.0.538",
    "kokoro-js": "1.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538"
  }
}
